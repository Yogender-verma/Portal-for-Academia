# ==========================================
# SkillBridge (SIH 26044) Root .gitignore
# Single Source of Truth .gitignore
# ==========================================

# 1. Environment variables & API Keys (Sensitive Secrets)
.env
.env.*
!.env.example
*.pem
*.key
*.cert

# 2. Node / Frontend Dependencies & Build Output
**/node_modules/
**/dist/
**/dist-ssr/
**/build/
**/out/
*.local
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
lerna-debug.log*

# 3. Python / Backend Caches & Virtual Environments
**/__pycache__/
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
*.py[cod]
*$py.class
*.so
.venv/
venv/
ENV/
env/
*.egg-info/
.eggs/

# 4. Databases & Local Storage
*.db
*.sqlite
*.sqlite3

# 5. Testing & Coverage Reports
.coverage
htmlcov/
**/coverage/
.hypothesis/

# 6. Logs & OS System Junk
logs/
*.log
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db

# 7. IDEs, Editors & Tooling
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.bak
.oxlintrc.json.local
